			    CALCULATE(MAX(MH_SmartOffer_PowerBI_Profit_Model[Yr1_Net_Profit_RM_M]), MH_SmartOffer_PowerBI_Profit_Model[Scenario] = "Normal Case")
			)
		formatString: \R\M\ #,0.0\M
