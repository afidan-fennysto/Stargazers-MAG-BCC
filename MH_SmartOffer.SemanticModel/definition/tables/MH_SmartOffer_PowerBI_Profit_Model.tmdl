table MH_SmartOffer_PowerBI_Profit_Model
	lineageTag: d034def7-92c2-5cef-ac6a-3fc40d109385

	measure 'Selected Extra Sales (RM M)' =
			IF(
			    HASONEVALUE(MH_SmartOffer_PowerBI_Profit_Model[Scenario]),
			    MAX(MH_SmartOffer_PowerBI_Profit_Model[Extra_Sales_RM_M]),
			    CALCULATE(MAX(MH_SmartOffer_PowerBI_Profit_Model[Extra_Sales_RM_M]), MH_SmartOffer_PowerBI_Profit_Model[Scenario] = "Normal Case")
			)
		formatString: \R\M\ #,0.0\M
		displayFolder: 2. Profit
		lineageTag: 83f956ea-d910-5f75-bb2c-2909f925e7ba

	measure 'Selected Gross Profit (RM M)' =
			IF(
			    HASONEVALUE(MH_SmartOffer_PowerBI_Profit_Model[Scenario]),
			    MAX(MH_SmartOffer_PowerBI_Profit_Model[Gross_Profit_75Pct_RM_M]),
			    CALCULATE(MAX(MH_SmartOffer_PowerBI_Profit_Model[Gross_Profit_75Pct_RM_M]), MH_SmartOffer_PowerBI_Profit_Model[Scenario] = "Normal Case")
			)
		formatString: \R\M\ #,0.0\M
		displayFolder: 2. Profit
