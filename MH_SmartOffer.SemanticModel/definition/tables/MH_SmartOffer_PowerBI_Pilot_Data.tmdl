table MH_SmartOffer_PowerBI_Pilot_Data
	lineageTag: 5c310fc1-be8a-531d-8700-ce4771272d1d

	measure 'AI Buyers %' = CALCULATE(AVERAGE(MH_SmartOffer_PowerBI_Pilot_Data[Buyers_Pct]), MH_SmartOffer_PowerBI_Pilot_Data[Group_Name] = "With Our AI System")
